{
  "name": "codexstyle",
  "version": "1.3.5",
  "description": "Offline Windows theme studio and launcher for OpenAI Codex Desktop.",
  "main": "out/main/index.js",
  "author": "CodexStyle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zhqiankun/codexDream.git"
  },
  "homepage": "https://github.com/Zhqiankun/codexDream#readme",
  "bugs": {
    "url": "https://github.com/Zhqiankun/codexDream/issues"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.22.0",
    "npm": "10.9.4"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "prepare:electron": "node scripts/ensure-electron.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:icons": "node scripts/generate-icons.mjs",
    "build": "npm run build:icons && npm run build:native && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:unit": "npm run build:native && vitest run tests/main --passWithNoTests",
    "test:renderer": "vitest run tests/renderer --passWithNoTests",
    "test:integration": "npm run build:native && vitest run tests/acceptance --passWithNoTests",
    "test:e2e": "npm run prepare:electron && npm run build && playwright test",
    "package:win": "npm run build && electron-builder --win --x64 --publish never && npm run release:update-manifest && npm run release:checksums",
    "release:update-manifest": "node scripts/finalize-update-manifest.mjs",
    "release:checksums": "node scripts/generate-checksums.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "architecture:check": "node scripts/architecture-check.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "css-tree": "3.2.1",
    "electron-updater": "6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "ws": "8.21.2",
    "yauzl": "3.3.1",
    "yazl": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/node": "22.15.30",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@typescript-eslint/parser": "8.46.2",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "js-yaml": "4.1.1",
    "jsdom": "26.1.0",
    "node-gyp": "12.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
